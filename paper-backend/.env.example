# 复制为 .env 后填写（.env 已被 git 忽略，切勿提交）

# 运行数据目录：数据库和上传的 PDF
DATA_DIR=data
DATABASE_URL=sqlite:///./data/app.db

# JWT 签名密钥，至少 32 字符：openssl rand -base64 48
JWT_KEY=
# 生产环境走 HTTPS 时改为 true
COOKIE_SECURE=false

# 在线文献检索（可选）
SEMANTIC_SCHOLAR_API_KEY=

# AI 功能（OpenAI 兼容接口），未配置时 AI 入口不可用，其他功能正常
AI_OPENAI_BASE_URL=https://api.deepseek.com/v1
AI_OPENAI_MODEL_ID=
AI_OPENAI_API_KEY=
