# 复制为 .env 后填写（.env 已被 git 忽略，切勿提交）

# ---- 必填 ----
POSTGRES_PASSWORD=
# JWT 签名密钥，至少 32 字符：openssl rand -base64 48
JWT_KEY=

# ---- 访问地址 ----
HTTP_PORT=3000
FRONTEND_URL=http://localhost:3000

# ---- 镜像源（国内服务器）----
# DOCKER_MIRROR=docker.hlug.cn
# UBI_IMAGE=docker.hlug.cn/redhat/ubi9:latest
# NPM_REGISTRY=https://registry.npmmirror.com/
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple

# ---- 数据目录 ----
# DATA_DIR=./data
# POSTGRES_DATA_DIR=./postgres

# ---- 邮件（注册/找回密码验证码）----
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=465
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

# ---- GitHub 登录（可选）----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- AI 助手 ----
AI_OPENAI_BASE_URL=https://api.deepseek.com/v1
AI_OPENAI_MODEL_ID=deepseek-flash
AI_OPENAI_API_KEY=
AI_OPENAI_FAST_REASONING_EFFORT=none
AI_OPENAI_DEEP_REASONING_EFFORT=high
# 论文语义检索（可选，OpenAI 兼容 /embeddings）
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_MODEL_ID=
AI_EMBEDDING_API_KEY=
# Python 分析沙箱
AI_SANDBOX_ENABLED=true
INSTALL_AI_SANDBOX=true
SEMANTIC_SCHOLAR_API_KEY=
