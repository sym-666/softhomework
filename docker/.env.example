# 复制为 .env 后填写（.env 已被 git 忽略，切勿提交）

# ---- 必填 ----
# JWT 签名密钥，至少 32 字符：openssl rand -base64 48
JWT_KEY=

# ---- 访问地址 ----
# 默认只监听本机；需要对外访问时改为 0.0.0.0，并配置 HTTPS 和 COOKIE_SECURE=true
HTTP_BIND=127.0.0.1
HTTP_PORT=3000
COOKIE_SECURE=false

# ---- AI 功能（OpenAI 兼容接口），未配置时 AI 入口不可用，其他功能正常 ----
AI_OPENAI_BASE_URL=https://api.deepseek.com/v1
AI_OPENAI_MODEL_ID=
AI_OPENAI_API_KEY=
# 使用 DeepSeek 时建议设为 low，其他服务不支持时留空
AI_OPENAI_REASONING_EFFORT=

# ---- 在线文献检索（可选）----
SEMANTIC_SCHOLAR_API_KEY=

# ---- 镜像源（国内服务器）----
# DOCKER_MIRROR=docker.hlug.cn
# NPM_REGISTRY=https://registry.npmmirror.com/
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
